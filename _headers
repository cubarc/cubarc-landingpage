# Seiten bei jedem Aufruf frisch prüfen, damit nach einem Update nie eine alte Fassung erscheint
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/impressum
  Cache-Control: public, max-age=0, must-revalidate
/datenschutz
  Cache-Control: public, max-age=0, must-revalidate
/benachrichtigen
  Cache-Control: public, max-age=0, must-revalidate
/functions/*
  X-Robots-Tag: noindex

# Vorschau der Landingpage: nicht in Suchmaschinen
/vorschau/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: public, max-age=0, must-revalidate

# App unter /app/: nicht in Suchmaschinen, immer die neueste Fassung
/app/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
/app
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# Neue Baumassenstudie unter /app5/ (cubarc v5): nicht in Suchmaschinen, immer die neueste Fassung
/app5/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
/app5
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# cubarc v6 (Gesamtfassung aus v3 und v5) unter /app6/: nicht in Suchmaschinen, immer die neueste Fassung
/app6/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
/app6
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# cubarc v7 (Baumasse aus Geschoßen, Geschoß-Editor) unter /app7/
/app7/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
/app7
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# Bilder und Schrift: eine Stunde zwischenspeichern
/img/*
  Cache-Control: public, max-age=3600
/vorschau/img/*
  Cache-Control: public, max-age=3600
/assets/*
  Cache-Control: public, max-age=86400
