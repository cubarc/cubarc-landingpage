# Seite bei jedem Aufruf frisch prüfen, damit nach einem Update nie eine alte Fassung erscheint
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Bilder: eine Stunde zwischenspeichern
/img/*
  Cache-Control: public, max-age=3600
